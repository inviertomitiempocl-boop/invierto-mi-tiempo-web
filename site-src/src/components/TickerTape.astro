---
const tickers = ['AAPL', 'SCHD', 'VICI', 'O', 'JEPI', 'KO', 'JNJ', 'NNN', 'STAG', 'HABITAT.SN'];
---
<div class="ticker-tape" aria-hidden="true">
  <div class="ticker-track" id="ticker-track">
    {[...tickers, ...tickers].map((t) => (
      <span class="ticker-item">
        <span class="ticker-sym">{t}</span>
        <span class="ticker-val">···</span>
      </span>
    ))}
  </div>
</div>

<script define:vars={{ tickers }}>
  const API = 'http://69.6.227.205:8001/app/scores?tickers=' + tickers.join(',');

  function scoreColor(ponderado) {
    if (ponderado >= 80) return '#2ECC71';
    if (ponderado >= 60) return '#F0A500';
    if (ponderado >= 40) return '#FF9F40';
    return '#FF5C5C';
  }

  function renderItem(r) {
    const sym = document.createElement('span');
    sym.className = 'ticker-sym';
    sym.textContent = r.ticker;

    const val = document.createElement('span');
    val.className = 'ticker-val';

    if (r.error || r.precio_actual == null) {
      val.textContent = 's/d';
      val.style.color = '#5C7A99';
    } else {
      const precio = '$' + r.precio_actual.toFixed(2);
      const ponderado = r.score?.ponderado;
      if (typeof ponderado === 'number') {
        val.textContent = `${precio} · ${ponderado}`;
        val.style.color = scoreColor(ponderado);
      } else if (typeof r.dividend_yield === 'number') {
        val.textContent = `${precio} · ${r.dividend_yield.toFixed(1)}%`;
        val.style.color = '#F0A500';
      } else {
        val.textContent = precio;
        val.style.color = '#B9C9DA';
      }
    }

    const item = document.createElement('span');
    item.className = 'ticker-item';
    item.append(sym, val);
    return item;
  }

  fetch(API)
    .then((res) => res.ok ? res.json() : Promise.reject(res.status))
    .then((data) => {
      const track = document.getElementById('ticker-track');
      if (!track || !Array.isArray(data.resultados)) return;
      const byTicker = Object.fromEntries(data.resultados.map((r) => [r.ticker, r]));
      const ordered = tickers.map((t) => byTicker[t] || { ticker: t, error: true });
      const doubled = [...ordered, ...ordered];
      track.replaceChildren(...doubled.map(renderItem));
    })
    .catch(() => {
      // Sin conexión con el backend: se deja el "···" de carga como estado honesto,
      // en vez de simular datos falsos.
    });
</script>

<style>
  .ticker-tape {
    background: #0A1D31;
    border-bottom: 1px solid rgba(240,165,0,0.15);
    overflow: hidden;
    white-space: nowrap;
    padding: 0.4rem 0;
  }

  .ticker-track {
    display: inline-flex;
    animation: scroll-left 32s linear infinite;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 0.78rem;
    padding: 0 1.25rem;
    border-right: 1px solid rgba(255,255,255,0.06);
  }

  .ticker-sym {
    color: #B9C9DA;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .ticker-val { color: #5C7A99; }

  @keyframes scroll-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }
</style>
